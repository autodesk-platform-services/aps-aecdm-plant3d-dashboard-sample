{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Dashboard running at (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Launch server (verbose)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DEBUG": "app:*",
        "ENABLE_DEBUG_ENDPOINTS": "true"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Dashboard running at (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Launch server (watch + verbose)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "runtimeArgs": ["--watch"],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DEBUG": "app:*",
        "ENABLE_DEBUG_ENDPOINTS": "true"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "restart": true
    },
    {
      "name": "Attach to running server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug front end (Chrome)",
      "type": "chrome",
      "request": "launch",
      // Keep this port in sync with PORT in .env.
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/public"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (server + browser)",
      "configurations": ["Launch server (watch + verbose)", "Debug front end (Chrome)"],
      "stopAll": true
    }
  ]
}
