{
  "name": "aps-aecdm-plant3d-dashboard-sample",
  "version": "1.0.0",
  "private": true,
  "description": "Sample dashboard: APS OAuth, AEC Data Model, and AutoCAD Plant 3D P&ID / 3D piping data sets",
  "repository": {
