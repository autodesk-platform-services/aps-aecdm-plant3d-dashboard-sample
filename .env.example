# APS app credentials — https://aps.autodesk.com/myapps
# The app must be of type "Traditional Web App" and have the AEC Data Model API enabled.
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Must match EXACTLY one of the Callback URLs registered on the APS app.
APS_CALLBACK_URL=http://localhost:8080/api/auth/callback

# Any random string — signs the session cookie.
SERVER_SESSION_SECRET=change-me-to-a-random-string

PORT=8080

# How the Plant 3D scan finds element groups:
#   folder  — list the project's folders, then scan each Plant 3D project folder
#             subtree with elementGroupsByFolderAndSubFolders, 4 at a time. Default.
#   project — one elementGroupsByProject cursor walk over the whole project.
#             Simpler, but times out on large projects.
ExtractGroupsWay=folder

# --- Debugging (all optional) ---

# Namespaced server logging. Comma-separated, "*" for everything.
# Namespaces: app:http, app:auth, app:graphql, app:dm, app:plant3d
# DEBUG=app:*

# Page size for AEC Data Model queries. Must be 1-99: the API rejects 100.
# AECDM_PAGE_LIMIT=50

# Mounts /api/debug/* — session info, the raw access token, and GraphQL/DM
# scratchpads. Local development only: it hands out the user's access token.
# ENABLE_DEBUG_ENDPOINTS=true

# Default path to a Plant 3D project's ProcessPower.dcf, used by server/schemas
# when no path is passed in. Opened read-only.
# PROCESSPOWER_DCF=/path/to/ProcessPower.dcf
